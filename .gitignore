.DS_Store
*.swp
*~

# Python (existing venv)
.venv/
__pycache__/

# JetBrains
.idea/

# CocoaPods
Pods/

# Swift Package Manager
.build/
Package.resolved

# Embedded frameworks (built from source — see Bridges/)
Frameworks/

# Flutter module build artifacts
Bridges/flutter_bridge/.dart_tool/
Bridges/flutter_bridge/.android/
Bridges/flutter_bridge/.ios/
Bridges/flutter_bridge/build/
Bridges/flutter_bridge/.idea/
Bridges/flutter_bridge/.metadata
Bridges/flutter_bridge/*.iml

# Capacitor bridge npm artifacts
# package-lock.json is committed, for the same reason Podfile.lock is (see below):
# CI installs with `npm ci`, which REQUIRES a lockfile and fails outright without
# one. Ignoring it also let every install re-resolve transitive dependencies, so
# the bridge being measured was not the same bridge from one run to the next.
Bridges/capacitor_bridge/node_modules/

# Cordova bridge — cordova.js is copied from node_modules at build time
Bridges/cordova_bridge/www/cordova.js
iPadDx/Resources/cordova_www/cordova.js

# React Native bridge build artifacts
# package-lock.json is committed — see the Capacitor note above.
Bridges/rn_bridge/node_modules/
Bridges/rn_bridge/ios/Pods/
Bridges/rn_bridge/ios/build/
Bridges/rn_bridge/ios/*.xcworkspace
iPadDx/Resources/main.jsbundle

# CocoaPods — both Pods/ and the workspace are GENERATED by `pod install`
# (see `make pods`). Podfile.lock is committed so the generated set is pinned.
# A fresh clone therefore has no iPadDx.xcworkspace until you run `make pods`;
# the Makefile targets check for it and say so.
*.xcworkspace

# Reports (generated at runtime)
reports/
